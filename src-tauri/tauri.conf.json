{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CI Watchtower",
  "version": "0.3.35",
  "identifier": "com.gycha.ciwatchtower",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CI Watchtower",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "GitHub Actions CI completion and queue monitor",
    "longDescription": "Monitors GitHub Actions runs per development track and sends Windows notifications when CI completes, fails, stalls, or the queue becomes congested.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
